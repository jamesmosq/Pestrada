# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y ajusta los valores según tu configuración

# Configuración de Base de Datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME_TAREAS=tareas_crud
DB_NAME_TODO=todo_list
DB_NAME_LOGIN=login_db
DB_CHARSET=utf8mb4

# Configuración de la Aplicación
APP_NAME="Pestrada - Curso PHP"
APP_VERSION=1.0.0
APP_ENV=development
BASE_URL=http://localhost/Pestrada_/

# Configuración de Sesiones
SESSION_LIFETIME=3600
SESSION_NAME=PESTRADA_SESSION

# Zona Horaria
TIMEZONE=America/Bogota

# Configuración de Errores (development/production)
ENVIRONMENT=development
DISPLAY_ERRORS=1
LOG_ERRORS=1
